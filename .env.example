# Public origin. Drives canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://vicestack.com

# Supabase — lead storage.
# The service role key is server-only and must never be exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — lead notification email.
# LEAD_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Set to "true" to allow indexing outside Vercel production. Leave unset locally.
ALLOW_INDEXING=
